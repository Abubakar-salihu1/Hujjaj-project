# Community Nexus Backend Configuration
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=production
PORT=5000

# Database
DB_PATH=./community.db

# CORS Configuration
CORS_ORIGIN=*

# Admin Credentials (for initial setup)
